# Copia este archivo como .env y elige UNA opción de LLM.

# Opción A: Claude (API de Anthropic) — https://console.anthropic.com
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=tu_api_key_aqui
# CLAUDE_MODEL=claude-opus-5-5

# Opción B: Ollama (local y gratis) — https://ollama.com  →  ollama pull llama3.2
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Opción C: sin LLM (solo muestra los fragmentos recuperados)
# LLM_PROVIDER=none

# Parámetros del RAG (opcionales)
# CHUNK_SIZE=700
# CHUNK_OVERLAP=120
# TOP_K=4
# MIN_SCORE=0.35
# PORT=3000
